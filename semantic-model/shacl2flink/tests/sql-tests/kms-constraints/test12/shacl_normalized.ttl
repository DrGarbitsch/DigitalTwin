@prefix iff: <https://industry-fusion.com/types/v0.9/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

iff:DepthShape a sh:NodeShape ;
    sh:property [ sh:or ( [ sh:property [ sh:or ( [ sh:property [ sh:or ( [ sh:maxInclusive 100 ;
                                                                sh:nodeKind sh:Literal ] ) ;
                                                    sh:path <https://uri.etsi.org/ngsi-ld/hasValue> ] ] ) ;
                                sh:path iff:torque ] ] ) ;
            sh:path iff:assembly ] ;
    sh:targetClass iff:depthtest .

iff:NodeLevelShape a sh:NodeShape ;
    sh:or ( [ sh:property [ sh:or ( [ sh:property [ sh:or ( [ sh:maxInclusive 50 ;
                                                        sh:nodeKind sh:Literal ] ) ;
                                            sh:path <https://uri.etsi.org/ngsi-ld/hasValue> ] ] ) ;
                        sh:path iff:temperature ] ] [ sh:property [ sh:or ( [ sh:property [ sh:or ( [ sh:minLength 1 ;
                                                        sh:nodeKind sh:Literal ] ) ;
                                            sh:path <https://uri.etsi.org/ngsi-ld/hasValue> ] ] ) ;
                        sh:path iff:coolant ] ] ) ;
    sh:property [ sh:not [ sh:property [ sh:or ( [ sh:in ( "FORBIDDEN" ) ;
                                        sh:nodeKind sh:Literal ] ) ;
                            sh:path <https://uri.etsi.org/ngsi-ld/hasValue> ] ] ;
            sh:path iff:mode ] ;
    sh:targetClass iff:depthtest .

