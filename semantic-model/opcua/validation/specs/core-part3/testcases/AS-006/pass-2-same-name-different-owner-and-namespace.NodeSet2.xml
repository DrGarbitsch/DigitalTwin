<?xml version="1.0" encoding="utf-8"?>
<!--
  AS-006 (OPC 10000-3 section 4.5.2) - PASS case 2: the two ways the same name
  is legal.

  Both of these would be rejected by a shape that compared BrowseName strings
  globally instead of per owner and per namespace:

    * Scoping. PumpObject and ValveObject each own a Property named
      "1:Manufacturer". Uniqueness is scoped to the Properties of one Node, and
      reusing a Property name across Nodes is the normal case, not a defect.

    * Namespace. PumpObject owns both "1:Manufacturer" (this model's namespace)
      and "Manufacturer" (Namespace 0). A BrowseName is a QualifiedName, so
      these are two different BrowseNames on the same owner, and this is how a
      companion specification adds its own Property alongside an inherited one.
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd">
  <NamespaceUris>
    <Uri>http://example.org/UA/AS-006/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://example.org/UA/AS-006/" Version="1.0.0" PublicationDate="2024-01-01T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.03" PublicationDate="2023-12-15T00:00:00Z"/>
    </Model>
  </Models>
  <Aliases>
    <Alias Alias="HasProperty">i=46</Alias>
    <Alias Alias="HasSubtype">i=45</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
    <Alias Alias="String">i=12</Alias>
  </Aliases>

  <UAObjectType NodeId="ns=1;i=1000" BrowseName="1:EquipmentType">
    <DisplayName>EquipmentType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference>
    </References>
  </UAObjectType>

  <UAObject NodeId="ns=1;i=2000" BrowseName="1:PumpObject">
    <DisplayName>PumpObject</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1000</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3000</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3001</Reference>
    </References>
  </UAObject>

  <UAObject NodeId="ns=1;i=2001" BrowseName="1:ValveObject">
    <DisplayName>ValveObject</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1000</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3002</Reference>
    </References>
  </UAObject>

  <UAVariable NodeId="ns=1;i=3000" BrowseName="1:Manufacturer" DataType="String" ParentNodeId="ns=1;i=2000">
    <DisplayName>Manufacturer (model namespace)</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=2000</Reference>
    </References>
  </UAVariable>

  <!-- Same local name as ns=1;i=3000, but a Namespace 0 BrowseName. -->
  <UAVariable NodeId="ns=1;i=3001" BrowseName="Manufacturer" DataType="String" ParentNodeId="ns=1;i=2000">
    <DisplayName>Manufacturer (Namespace 0)</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=2000</Reference>
    </References>
  </UAVariable>

  <!-- Same BrowseName as ns=1;i=3000, but a different owner. -->
  <UAVariable NodeId="ns=1;i=3002" BrowseName="1:Manufacturer" DataType="String" ParentNodeId="ns=1;i=2001">
    <DisplayName>Manufacturer (other owner)</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=2001</Reference>
    </References>
  </UAVariable>
</UANodeSet>
