<?xml version="1.0" encoding="utf-8"?>
<!--
  AS-031 (OPC 10000-3 section 7, HasComponent) - FAIL case 2: disallowed
  TargetNodes.

  A HasComponent target must be a Variable, an Object or a Method. Here an
  Object owns an ObjectType and a DataType as if they were components. This is
  what a type reference written as a containment reference looks like: the
  NodeIds resolve, the nodeset translates, and only the NodeClass of the target
  shows that the model says something it cannot mean.
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd">
  <NamespaceUris>
    <Uri>http://example.org/UA/AS-031/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://example.org/UA/AS-031/" Version="1.0.0" PublicationDate="2024-01-01T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.03" PublicationDate="2023-12-15T00:00:00Z"/>
    </Model>
  </Models>
  <Aliases>
    <Alias Alias="HasComponent">i=47</Alias>
    <Alias Alias="HasSubtype">i=45</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
    <Alias Alias="String">i=12</Alias>
  </Aliases>

  <UAObjectType NodeId="ns=1;i=1000" BrowseName="1:PumpType">
    <DisplayName>PumpType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference>
    </References>
  </UAObjectType>

  <!-- Violation: an ObjectType as the target of a HasComponent Reference. -->
  <UAObjectType NodeId="ns=1;i=1001" BrowseName="1:SubUnitType">
    <DisplayName>SubUnitType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=2000</Reference>
    </References>
  </UAObjectType>

  <!-- Violation: a DataType as the target of a HasComponent Reference. -->
  <UADataType NodeId="ns=1;i=1002" BrowseName="1:PumpStateEnum">
    <DisplayName>PumpStateEnum</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=29</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=2000</Reference>
    </References>
  </UADataType>

  <UAObject NodeId="ns=1;i=2000" BrowseName="1:PumpObject">
    <DisplayName>PumpObject</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1000</Reference>
      <Reference ReferenceType="HasComponent">ns=1;i=1001</Reference>
      <Reference ReferenceType="HasComponent">ns=1;i=1002</Reference>
      <Reference ReferenceType="HasComponent">ns=1;i=3000</Reference>
    </References>
  </UAObject>

  <!-- Correct sibling: must not be reported. -->
  <UAVariable NodeId="ns=1;i=3000" BrowseName="1:Pressure" DataType="String" ParentNodeId="ns=1;i=2000">
    <DisplayName>Pressure</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=63</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=2000</Reference>
    </References>
  </UAVariable>
</UANodeSet>
