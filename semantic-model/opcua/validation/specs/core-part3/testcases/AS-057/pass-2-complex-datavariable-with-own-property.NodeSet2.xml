<?xml version="1.0" encoding="utf-8"?>
<!--
  AS-057 (OPC 10000-3 section 5.6.3, 5.6.4) - PASS case 2.

  A complex DataVariable. Pressure is a DataVariable (reached by HasComponent)
  and is itself allowed to own both a nested DataVariable (HasComponent) and a
  Property (HasProperty), which 5.6.4 permits once a Variable has been
  identified as a DataVariable by an incoming HasComponent Reference.

  This is the case a naive shape gets wrong: HasProperty and HasComponent
  edges do meet at Pressure, but as outgoing edges, not incoming ones. The rule
  is about a Variable's incoming references only.
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd">
  <NamespaceUris>
    <Uri>http://example.org/UA/AS-057/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://example.org/UA/AS-057/" Version="1.0.0" PublicationDate="2024-01-01T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.03" PublicationDate="2023-12-15T00:00:00Z"/>
    </Model>
  </Models>
  <Aliases>
    <Alias Alias="HasComponent">i=47</Alias>
    <Alias Alias="HasProperty">i=46</Alias>
    <Alias Alias="HasSubtype">i=45</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
    <Alias Alias="String">i=12</Alias>
  </Aliases>

  <UAObjectType NodeId="ns=1;i=1000" BrowseName="1:PumpType">
    <DisplayName>PumpType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference>
    </References>
  </UAObjectType>

  <UAObject NodeId="ns=1;i=2000" BrowseName="1:PumpObject">
    <DisplayName>PumpObject</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1000</Reference>
      <Reference ReferenceType="HasComponent">ns=1;i=3001</Reference>
    </References>
  </UAObject>

  <!-- DataVariable: reached by HasComponent, and therefore allowed children. -->
  <UAVariable NodeId="ns=1;i=3001" BrowseName="1:Pressure" DataType="String" ParentNodeId="ns=1;i=2000">
    <DisplayName>Pressure</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=63</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=2000</Reference>
      <Reference ReferenceType="HasComponent">ns=1;i=3002</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3003</Reference>
    </References>
  </UAVariable>

  <UAVariable NodeId="ns=1;i=3002" BrowseName="1:RawValue" DataType="String" ParentNodeId="ns=1;i=3001">
    <DisplayName>RawValue</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=63</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=3001</Reference>
    </References>
  </UAVariable>

  <UAVariable NodeId="ns=1;i=3003" BrowseName="1:EngineeringUnits" DataType="String" ParentNodeId="ns=1;i=3001">
    <DisplayName>EngineeringUnits</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=3001</Reference>
    </References>
  </UAVariable>
</UANodeSet>
