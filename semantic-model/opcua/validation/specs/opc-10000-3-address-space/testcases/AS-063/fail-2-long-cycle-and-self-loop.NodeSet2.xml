<?xml version="1.0" encoding="utf-8"?>
<!--
  AS-063 (OPC 10000-3 section 7.17) - FAIL case 2: a longer cycle and a self
  loop.

  Two shapes of the defect that a fixed-length check would miss:

    * A three-node cycle (Plant, Area, Cell) that also mixes HasEventSource and
      HasNotifier, so it is only found by following the ReferenceType
      alternation transitively rather than one hop at a time.

    * A one-node self loop (Reactor notifies from itself), the shortest cycle
      there is, which a query written as "two distinct nodes reachable from
      each other" would not report.
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd">
  <NamespaceUris>
    <Uri>http://example.org/UA/AS-063/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://example.org/UA/AS-063/" Version="1.0.0" PublicationDate="2024-01-01T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.03" PublicationDate="2023-12-15T00:00:00Z"/>
    </Model>
  </Models>
  <Aliases>
    <Alias Alias="HasEventSource">i=36</Alias>
    <Alias Alias="HasNotifier">i=48</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
  </Aliases>

  <!-- Violation: three-node cycle, part 1. -->
  <UAObject NodeId="ns=1;i=2000" BrowseName="1:Plant" EventNotifier="1">
    <DisplayName>Plant</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=58</Reference>
      <Reference ReferenceType="HasNotifier">ns=1;i=2001</Reference>
    </References>
  </UAObject>

  <!-- Violation: three-node cycle, part 2. -->
  <UAObject NodeId="ns=1;i=2001" BrowseName="1:Area" EventNotifier="1">
    <DisplayName>Area</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=58</Reference>
      <Reference ReferenceType="HasNotifier" IsForward="false">ns=1;i=2000</Reference>
      <Reference ReferenceType="HasEventSource">ns=1;i=2002</Reference>
    </References>
  </UAObject>

  <!-- Violation: three-node cycle, part 3, closing back to Plant. -->
  <UAObject NodeId="ns=1;i=2002" BrowseName="1:Cell" EventNotifier="1">
    <DisplayName>Cell</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=58</Reference>
      <Reference ReferenceType="HasEventSource" IsForward="false">ns=1;i=2001</Reference>
      <Reference ReferenceType="HasNotifier">ns=1;i=2000</Reference>
    </References>
  </UAObject>

  <!-- Violation: self loop. -->
  <UAObject NodeId="ns=1;i=2003" BrowseName="1:Reactor" EventNotifier="1">
    <DisplayName>Reactor</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=58</Reference>
      <Reference ReferenceType="HasNotifier">ns=1;i=2003</Reference>
    </References>
  </UAObject>
</UANodeSet>
