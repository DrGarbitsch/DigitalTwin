<?xml version="1.0" encoding="utf-8"?>
<!--
  AS-006 (OPC 10000-3 section 4.5.2) - FAIL case 2: duplicate on a type, and on
  a Variable owner.

  Two owners, two distinct reasons to catch the same defect elsewhere in the
  address space than fail case 1:

    * PumpType is an ObjectType whose two Property InstanceDeclarations share
      the BrowseName "1:Manufacturer". Every instance of the type inherits the
      ambiguity, so a duplicate here is worse than one on a single instance.

    * Pressure is a DataVariable, and Part 3 scopes this rule to any Node with
      Properties, not just to Objects and types. Its two Properties both use
      "1:EngineeringUnits".
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd">
  <NamespaceUris>
    <Uri>http://example.org/UA/AS-006/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://example.org/UA/AS-006/" Version="1.0.0" PublicationDate="2024-01-01T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.03" PublicationDate="2023-12-15T00:00:00Z"/>
    </Model>
  </Models>
  <Aliases>
    <Alias Alias="HasComponent">i=47</Alias>
    <Alias Alias="HasModellingRule">i=37</Alias>
    <Alias Alias="HasProperty">i=46</Alias>
    <Alias Alias="HasSubtype">i=45</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
    <Alias Alias="String">i=12</Alias>
  </Aliases>

  <!-- Violation: two Property InstanceDeclarations share a BrowseName. -->
  <UAObjectType NodeId="ns=1;i=1000" BrowseName="1:PumpType">
    <DisplayName>PumpType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=1001</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=1002</Reference>
    </References>
  </UAObjectType>

  <UAVariable NodeId="ns=1;i=1001" BrowseName="1:Manufacturer" DataType="String" ParentNodeId="ns=1;i=1000">
    <DisplayName>Manufacturer</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasModellingRule">i=78</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=1000</Reference>
    </References>
  </UAVariable>

  <UAVariable NodeId="ns=1;i=1002" BrowseName="1:Manufacturer" DataType="String" ParentNodeId="ns=1;i=1000">
    <DisplayName>Manufacturer (duplicate)</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasModellingRule">i=80</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=1000</Reference>
    </References>
  </UAVariable>

  <UAObject NodeId="ns=1;i=2000" BrowseName="1:PumpObject">
    <DisplayName>PumpObject</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1000</Reference>
      <Reference ReferenceType="HasComponent">ns=1;i=3000</Reference>
    </References>
  </UAObject>

  <!-- Violation: the owner is a DataVariable, not an Object or a type. -->
  <UAVariable NodeId="ns=1;i=3000" BrowseName="1:Pressure" DataType="String" ParentNodeId="ns=1;i=2000">
    <DisplayName>Pressure</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=63</Reference>
      <Reference ReferenceType="HasComponent" IsForward="false">ns=1;i=2000</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3001</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3002</Reference>
    </References>
  </UAVariable>

  <UAVariable NodeId="ns=1;i=3001" BrowseName="1:EngineeringUnits" DataType="String" ParentNodeId="ns=1;i=3000">
    <DisplayName>EngineeringUnits</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=3000</Reference>
    </References>
  </UAVariable>

  <UAVariable NodeId="ns=1;i=3002" BrowseName="1:EngineeringUnits" DataType="String" ParentNodeId="ns=1;i=3000">
    <DisplayName>EngineeringUnits (duplicate)</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">i=68</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=3000</Reference>
    </References>
  </UAVariable>
</UANodeSet>
