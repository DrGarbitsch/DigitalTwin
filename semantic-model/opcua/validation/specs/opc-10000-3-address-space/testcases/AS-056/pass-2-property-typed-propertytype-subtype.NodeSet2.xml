<?xml version="1.0" encoding="utf-8"?>
<!--
  AS-056 (OPC 10000-3 section 5.6.3) - PASS case 2: a derived Property type.

  This fixture is what makes the shape's subtype decision explicit and
  testable. Manufacturer is typed VendorPropertyType, a VariableType derived
  from PropertyType, which is how a companion specification adds its own
  Property flavour.

  The catalog records 5.6.3 as naming PropertyType without an explicit "or a
  subtype" allowance, so this case is the one that would have to change if the
  strict reading is ever confirmed against the primary text: the shape would
  drop the * from rdfs:subClassOf* and this file would move to a fail case. It
  is deliberately a separate fixture from pass case 1 so that decision shows up
  as one file changing category rather than as a silent edit to a shape.
-->
<UANodeSet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:xsd="http://www.w3.org/2001/XMLSchema"
           xmlns="http://opcfoundation.org/UA/2011/03/UANodeSet.xsd">
  <NamespaceUris>
    <Uri>http://example.org/UA/AS-056/</Uri>
  </NamespaceUris>
  <Models>
    <Model ModelUri="http://example.org/UA/AS-056/" Version="1.0.0" PublicationDate="2024-01-01T00:00:00Z">
      <RequiredModel ModelUri="http://opcfoundation.org/UA/" Version="1.05.03" PublicationDate="2023-12-15T00:00:00Z"/>
    </Model>
  </Models>
  <Aliases>
    <Alias Alias="HasProperty">i=46</Alias>
    <Alias Alias="HasSubtype">i=45</Alias>
    <Alias Alias="HasTypeDefinition">i=40</Alias>
    <Alias Alias="String">i=12</Alias>
  </Aliases>

  <UAObjectType NodeId="ns=1;i=1000" BrowseName="1:PumpType">
    <DisplayName>PumpType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=58</Reference>
    </References>
  </UAObjectType>

  <UAVariableType NodeId="ns=1;i=1100" BrowseName="1:VendorPropertyType" DataType="String" ValueRank="-1">
    <DisplayName>VendorPropertyType</DisplayName>
    <References>
      <Reference ReferenceType="HasSubtype" IsForward="false">i=68</Reference>
    </References>
  </UAVariableType>

  <UAObject NodeId="ns=1;i=2000" BrowseName="1:PumpObject">
    <DisplayName>PumpObject</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1000</Reference>
      <Reference ReferenceType="HasProperty">ns=1;i=3000</Reference>
    </References>
  </UAObject>

  <UAVariable NodeId="ns=1;i=3000" BrowseName="1:Manufacturer" DataType="String" ParentNodeId="ns=1;i=2000">
    <DisplayName>Manufacturer</DisplayName>
    <References>
      <Reference ReferenceType="HasTypeDefinition">ns=1;i=1100</Reference>
      <Reference ReferenceType="HasProperty" IsForward="false">ns=1;i=2000</Reference>
    </References>
  </UAVariable>
</UANodeSet>
