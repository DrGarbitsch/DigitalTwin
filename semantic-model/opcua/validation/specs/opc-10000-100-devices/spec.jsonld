  "rules": [
    {
      "@id": "rule:DI-001",
      "@type": "ValidationRule",
      "id": "DI-001",
      "section": "4.4.1",
      "summary": "BrowseNames of Nodes organized by one FunctionalGroup are unique",
      "status": "gap"
    },
    {
      "@id": "rule:DI-002",
      "@type": "ValidationRule",
      "id": "DI-002",
      "section": "4.9",
      "summary": "DeviceSet hierarchically reaches every ComponentType instance",
      "status": "gap"
    },
    {
      "@id": "rule:DI-003",
      "@type": "ValidationRule",
      "id": "DI-003",
      "section": "4.9",
      "summary": "Only the root instance of a complex Device hangs off DeviceSet",
      "status": "gap"
    },
    {
      "@id": "rule:DI-004",
      "@type": "ValidationRule",
      "id": "DI-004",
      "section": "4.3",
      "summary": "MethodSet is present only if it holds at least one Method",
      "status": "gap"
    },
    {
      "@id": "rule:DI-005",
      "@type": "ValidationRule",
      "id": "DI-005",
      "section": "5.6",
      "summary": "Every Network is a component of NetworkSet",
      "status": "gap"
    },
    {
      "@id": "rule:DI-006",
      "@type": "ValidationRule",
      "id": "DI-006",
      "section": "5.4",
      "summary": "Every ConnectionPoint is a component of its Device",
      "status": "gap"
    },
    {
      "@id": "rule:DI-007",
      "@type": "ValidationRule",
      "id": "DI-007",
      "section": "4.7",
      "summary": "Mandatory Properties of DeviceType are present on every instance",
      "status": "push-down"
    },
    {
      "@id": "rule:DI-008",
      "@type": "ValidationRule",
      "id": "DI-008",
      "section": "4.5.4",
      "summary": "DeviceHealth is one of the five NAMUR NE107 values",
      "status": "instance-level"
    },
    {
      "@id": "rule:DI-009",
      "@type": "ValidationRule",
      "id": "DI-009",
      "section": "5.2",
      "summary": "A ProtocolType instance's BrowseName defines the Communication Profile",
      "status": "n/a"
    },
    {
      "@id": "rule:DI-010",
      "@type": "ValidationRule",
      "id": "DI-010",
      "section": "4.3, 5.3",
      "summary": "Clients use LockingServices for multi-step consistent changes",
      "status": "n/a"
    },
    {
      "@id": "rule:DI-011",
      "@type": "ValidationRule",
      "id": "DI-011",
      "section": "4.4.2",
      "summary": "Well-known BrowseNames for standard FunctionalGroups",
      "status": "n/a"
    },
    {
      "@id": "rule:DI-012",
      "@type": "ValidationRule",
      "id": "DI-012",
      "section": "4.4.1",
      "summary": "A hideable FunctionalGroup carries an appropriate ModellingRule",
      "status": "advanced"
    },
    {
      "@id": "rule:DI-013",
      "@type": "ValidationRule",
      "id": "DI-013",
      "section": "3.3.3.1-3.3.3.3",
      "summary": "Common Attributes are set as Tables 7-9 specify",
      "status": "gap"
    },
    {
      "@id": "rule:DI-014",
      "@type": "ValidationRule",
      "id": "DI-014",
      "section": "3.3.3.3, 3.3.3.4",
      "summary": "A ValueRank above zero requires ArrayDimensions to be specified",
      "status": "gap"
    },
    {
      "@id": "rule:DI-015",
      "@type": "ValidationRule",
      "id": "DI-015",
      "section": "3.3.3.5",
      "summary": "Methods defined by this specification are executable",
      "status": "blocked"
    },
    {
      "@id": "rule:DI-016",
      "@type": "ValidationRule",
      "id": "DI-016",
      "section": "3.3.1.1",
      "summary": "References between two exposed Nodes are exposed as well",
